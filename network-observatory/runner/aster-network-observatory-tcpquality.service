[Unit]
Description=Aster isolated TcpQuality execution helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/libexec/aster-network-observatory/tcpquality_helper.py
Restart=on-failure
RestartSec=10s
UMask=0077
KillMode=control-group
TimeoutStopSec=45s

[Install]
WantedBy=multi-user.target
