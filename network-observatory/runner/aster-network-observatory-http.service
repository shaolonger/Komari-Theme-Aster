[Unit]
Description=Aster authenticated HTTPS speed counterpart
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aster-netobs
Group=aster-netobs
ExecStart=/usr/bin/python3 /usr/local/libexec/aster-network-observatory/http_receiver.py --config /etc/aster-network-observatory/http-receiver.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
